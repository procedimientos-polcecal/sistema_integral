NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Remises — notificaciones push (Web Push / VAPID). Generar con:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_CONTACT_EMAIL=

# Protege el endpoint de cron nocturno (Vercel manda este mismo valor en el
# header Authorization al invocarlo). Generar cualquier string aleatorio largo.
CRON_SECRET=

# --- Modulo Compras: sincronizacion con Google Sheets (transicion) ---
# ID de la planilla PEDIDOS DE COMPRA (esta en la URL del documento).
# Sin esto, la sincronizacion simplemente no corre.
GOOGLE_SHEETS_COMPRAS_ID=
# JSON completo de la cuenta de servicio, en una sola linea.
# La cuenta necesita permiso de EDITOR sobre la planilla.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Protege el webhook que dispara el Apps Script de la planilla.
SHEETS_WEBHOOK_SECRET=
