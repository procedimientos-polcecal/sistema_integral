NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Remises — notificaciones push (Web Push / VAPID). Generar con:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_CONTACT_EMAIL=

# Protege el endpoint de cron nocturno (Vercel manda este mismo valor en el
# header Authorization al invocarlo). Generar cualquier string aleatorio largo.
CRON_SECRET=

# --- Modulo Compras: sincronizacion con Google Sheets (transicion) ---
# ID de la planilla PEDIDOS DE COMPRA (esta en la URL del documento).
# Sin esto, la sincronizacion simplemente no corre.
GOOGLE_SHEETS_COMPRAS_ID=
# JSON completo de la cuenta de servicio, en una sola linea.
# La cuenta necesita permiso de EDITOR sobre la planilla.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Id del Excel con la base de proveedores que lleva administracion (esta en la
# URL del archivo en Drive). La cuenta de servicio necesita permiso de LECTURA.
# Puede ser una planilla de Google o un .xlsx subido: la app lo resuelve sola.
GOOGLE_DRIVE_PROVEEDORES_ID=
# Carpeta de Drive donde viven las planillas de comparativa (esta en la URL de
# la carpeta). La cuenta de servicio necesita permiso de EDITOR: la app no solo
# lee, tambien agrega filas y marca la eleccion.
GOOGLE_DRIVE_COMPARATIVAS_FOLDER_ID=
# --- Modulo Mantenimiento: planilla de avisos ---
# ID de la planilla donde se reportan los avisos (esta en su URL). La lee la
# misma cuenta de servicio que Compras, asi que hay que compartirsela.
GOOGLE_SHEETS_AVISOS_ID=
# Nombre de la pestana. Si no se pone, se prueba con "AVISOS"; si no existe,
# el error dice cuales tiene la planilla.
GOOGLE_SHEETS_AVISOS_TAB=
# ID de la planilla ORDEN DE TRABAJO y su pestana (por defecto "OT").
GOOGLE_SHEETS_OT_ID=
GOOGLE_SHEETS_OT_TAB=

# Protege el webhook que dispara el Apps Script de la planilla.
SHEETS_WEBHOOK_SECRET=

# URL publica de la app. Se usa para armar los links de los correos de
# recuperacion de contrasena y de alta de usuarios. Sin esto se deduce del
# host de la peticion, que no siempre es confiable detras de un proxy.
NEXT_PUBLIC_APP_URL=
