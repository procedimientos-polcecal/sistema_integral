# Copiar como `.env` al lado del docker-compose.yml. NO se commitea.
#
# Lleva la contraseña de la cuenta que lee el servidor de archivos, así que el
# archivo tiene que quedar con permisos de sólo el dueño:
#   chmod 600 .env

# El servidor de archivos. Puede ser el nombre o la IP; si el nombre no
# resuelve desde el host de Docker, poner la IP.
SMB_SERVIDOR=server

# La cuenta que lee \\server\EXTERIOR. Con permiso de LECTURA alcanza: los
# volúmenes se montan `ro` y el contenedor no escribe nada del lado del
# servidor.
SMB_USUARIO=
SMB_CLAVE=
SMB_DOMINIO=

# Opcional. Si no se pone, la imagen ya trae la de Argentina.
# TZ=America/Argentina/Buenos_Aires
