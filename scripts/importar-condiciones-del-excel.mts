// Las 44 condiciones inseguras del Excel al sistema, UNA SOLA VEZ.
//
// POR QUÉ EXISTE
//
// `21-10-26.xlsm` es la planilla que circulaba por mail con las condiciones
// inseguras de la planta. Seguridad e Higiene la reemplaza: el sistema pasa a
// ser el único lugar donde se carga una, y lo que sólo está en la planilla
// entra acá, una vez. Después la planilla no se vuelve a leer.
// Spec: docs/superpowers/specs/2026-10-29-seguridad-e-higiene-design.md
//
// QUÉ HACE Y QUÉ NO
//
// - **Sin `--escribir` no escribe nada.** Lee el archivo y los catálogos, arma
//   las 44 filas e imprime qué enlazó y qué no. Es como se corre primero.
// - **Es todo o nada.** Una fila que no se puede armar (sin descripción, un
//   puntaje fuera de la escala) corta antes de escribir. El insert es un solo
//   pedido, así que la base tampoco queda a medias.
// - **Es idempotente.** Cada fila lleva la clave `excel-21-10-26-<N°>`: la
//   segunda corrida no inserta lo que la primera ya metió.
// - **El enlace es una igualdad, no un parecido.** Ver `lib/seguridadHigiene/
//   filaDelExcel.ts`. Lo que no se reconoce con certeza queda en null y se
//   lista abajo; un enlace equivocado no se nota nunca.
// - **El peligro no se importa**: la planilla no tiene esa columna. Está dentro
//   de la descripción («riesgo de atrapamiento») y deducirlo con una búsqueda
//   de texto es exactamente el enlace al que se le parece.
// - **Las fotos tampoco**: son vínculos al disco de quien armó la planilla y esa
//   carpeta no la tenemos. Entran las 44 sin foto, y la salida dice cuántas
//   había y cómo se llaman. No se inventa ningún reemplazo.
//
// LO QUE HAY QUE HACER AL FINAL, Y POR QUÉ ESTÁ ACÁ
//
// 1. **Adelantar la secuencia de `numero`.** La tabla conserva el N° de la
//    planilla (`generated by default`), y un insert con número explícito NO
//    mueve la secuencia: sin esto, la primera condición cargada desde el
//    teléfono pide el 1 y choca con el `unique` (23505). El script no puede
//    correr `setval` —no hay conexión SQL, sólo PostgREST—, así que consume
//    números con inserts de prueba hasta que uno entra, y borra ése.
// 2. **Escribir la foto de avisos del día.** Sin ella, el primer resumen diario
//    anuncia «+35 · Condiciones inseguras sin completar», una novedad que no
//    pasó, y después se calla por semanas: la `cantidad` de un aviso se compara
//    contra la foto del día anterior.
//
// Uso:
//   npx tsx scripts/importar-condiciones-del-excel.mts <ruta al .xlsm>
//   npx tsx scripts/importar-condiciones-del-excel.mts <ruta al .xlsm> --escribir
//
// Necesita Python con openpyxl, y las claves de Supabase en `.env.local`.
import { readFileSync, existsSync } from "node:fs";
import { execFileSync } from "node:child_process";
import { fileURLToPath } from "node:url";

// El env se carga ANTES de importar los módulos que lo leen al evaluarse.
const env = new URL("../.env.local", import.meta.url);
if (existsSync(env)) {
  for (const line of readFileSync(env, "utf-8").split("\n")) {
    const m = line.match(/^([A-Z_]+)=(.*)$/);
    if (m && !process.env[m[1]]) process.env[m[1]] = m[2].trim();
  }
}

const { createAdminClient } = await import("../lib/supabase/admin.ts");
const { traerTodo } = await import("../lib/core/paginado.ts");
const { hoyEnArgentina } = await import("../lib/core/fechas.ts");
const { guardarFoto } = await import("../lib/home/fotoDeAvisos.ts");
const { avisosDeTodoElSistema } = await import("../lib/home/avisosDeUsuario.ts");
const { condicionDeLaFila } = await import("../lib/seguridadHigiene/filaDelExcel.ts");
type FilaDelExcel = import("../lib/seguridadHigiene/filaDelExcel.ts").FilaDelExcel;
type CondicionAInsertar = import("../lib/seguridadHigiene/filaDelExcel.ts").CondicionAInsertar;

const args = process.argv.slice(2);
const escribir = args.includes("--escribir");
const ruta = args.find((a) => !a.startsWith("--"));
if (!ruta) {
  console.error("Falta la ruta al .xlsm.\nUso: npx tsx scripts/importar-condiciones-del-excel.mts <ruta> [--escribir]");
  process.exit(1);
}
if (!existsSync(ruta)) {
  console.error(`No existe ${ruta}`);
  process.exit(1);
}

const TABLA = "syh_condiciones";
const PREFIJO_DE_CLAVE = "excel-21-10-26-";

// ── El archivo ──────────────────────────────────────────────
// Lo lee Python con `-I` y no se ejecuta nada de la carpeta del archivo: llegó
// de afuera y se lo trata como dato.
// `fileURLToPath` y no `.pathname`: la carpeta del proyecto tiene un espacio, que la URL escribe %20.
const lector = fileURLToPath(new URL("./leer-condiciones-del-excel.py", import.meta.url));
const python = process.env.PYTHON ?? (process.platform === "win32" ? "python" : "python3");
let leido: { filas: FilaDelExcel[]; ignoradas_con_algo: number[] };
try {
  const salida = execFileSync(python, ["-I", lector, ruta], {
    encoding: "utf-8",
    maxBuffer: 32 * 1024 * 1024,
  });
  leido = JSON.parse(salida);
} catch (e) {
  console.error(`No se pudo leer el Excel: ${(e as Error).message}`);
  process.exit(1);
}

const db = createAdminClient();

// ── Los catálogos ───────────────────────────────────────────
const sectores = await traerTodo((desde, hasta) =>
  db.from("sectores").select("id, nombre, activo").range(desde, hasta)
);
const usuariosCrudos = await traerTodo((desde, hasta) =>
  db.from("usuarios").select("id, nombre, apellido, activo").range(desde, hasta)
);
const usuarios = usuariosCrudos
  .filter((u) => u.activo !== false)
  .map((u) => ({ id: u.id as string, nombre: `${u.nombre ?? ""} ${u.apellido ?? ""}`.trim() }));

const hoy = hoyEnArgentina();

// ── Las 44 filas ────────────────────────────────────────────
const filas: CondicionAInsertar[] = [];
const fotosDeLaFila = new Map<number, string[]>();
const nivelDeLaPlanilla = new Map<number, number>();
const avisosDeFila = new Map<number, string[]>();
const lugaresSinEnlazar = new Map<string, number[]>();
const responsablesSinEnlazar = new Map<string, number[]>();
const rechazos: string[] = [];

for (const fila of leido.filas) {
  const r = condicionDeLaFila(fila, { sectores, usuarios, hoy });
  if (!r.ok) {
    rechazos.push(r.motivo);
    continue;
  }
  filas.push(r.condicion);
  fotosDeLaFila.set(r.condicion.numero, fila.fotos);
  if (fila.nivel !== null) nivelDeLaPlanilla.set(r.condicion.numero, fila.nivel);
  if (r.avisos.length) avisosDeFila.set(r.condicion.numero, r.avisos);
  if (r.lugarSinEnlazar) lugaresSinEnlazar.set(r.lugarSinEnlazar, [...(lugaresSinEnlazar.get(r.lugarSinEnlazar) ?? []), r.condicion.numero]);
  if (r.responsableSinEnlazar) responsablesSinEnlazar.set(r.responsableSinEnlazar, [...(responsablesSinEnlazar.get(r.responsableSinEnlazar) ?? []), r.condicion.numero]);
}

const numeros = filas.map((f) => f.numero);
const repetidos = numeros.filter((n, i) => numeros.indexOf(n) !== i);
if (repetidos.length) rechazos.push(`N° repetidos en la planilla: ${[...new Set(repetidos)].join(", ")}`);

console.log(`Excel: ${ruta}`);
console.log(`Filas con descripción: ${leido.filas.length}`);
if (leido.ignoradas_con_algo.length) {
  console.log(`Filas SIN descripción pero con algo escrito a mano (se descartan): ${leido.ignoradas_con_algo.join(", ")}`);
}
if (rechazos.length) {
  console.error("\nNO SE ESCRIBE NADA. Estas filas no se pueden armar:");
  for (const m of rechazos) console.error(`  - ${m}`);
  process.exit(1);
}

// ── El informe ──────────────────────────────────────────────
const contar = (f: (c: CondicionAInsertar) => boolean) => filas.filter(f).length;
const totalDeFotos = [...fotosDeLaFila.values()].reduce((s, f) => s + f.length, 0);
const sinFotoEnElExcel = [...fotosDeLaFila.values()].filter((f) => f.length === 0).length;

console.log(`\nArmadas: ${filas.length} (N° ${Math.min(...numeros)} a ${Math.max(...numeros)})`);
console.log(`  con sector enlazado:        ${contar((c) => c.sector_id !== null)}`);
console.log(`  SIN sector:                 ${contar((c) => c.sector_id === null)}`);
console.log(`  con responsable enlazado:   ${contar((c) => c.responsable_id !== null)}`);
console.log(`  SIN responsable:            ${contar((c) => c.responsable_id === null)}`);
console.log(`  con peligro:                ${contar((c) => c.peligro_id !== null)}  (la planilla no tiene esa columna)`);
console.log(`  SIN peligro:                ${contar((c) => c.peligro_id === null)}`);
console.log(`  evaluadas (5 puntajes):     ${contar((c) => c.frecuencia !== null)}`);
console.log(`  cerradas (con ejecución):   ${contar((c) => c.fecha_ejecucion !== null)}`);
console.log(`  FOTOS que se importan:      0  ← las ${filas.length} entran sin foto`);

console.log(`\nLugares que no se enlazaron (${lugaresSinEnlazar.size} textos distintos, ${[...lugaresSinEnlazar.values()].flat().length} filas) — a resolver por una persona:`);
for (const [texto, ns] of [...lugaresSinEnlazar].sort((a, b) => b[1].length - a[1].length)) {
  console.log(`  ${String(ns.length).padStart(2)} × «${texto}»  (N° ${ns.join(", ")})`);
}
console.log(`\nResponsables que no se enlazaron:`);
if (responsablesSinEnlazar.size === 0) console.log("  ninguno");
for (const [texto, ns] of responsablesSinEnlazar) console.log(`  ${ns.length} × «${texto}»  (N° ${ns.join(", ")})`);
console.log(`\nQuién detectó: ninguna fila lo enlaza a un usuario; el nombre queda en las observaciones.`);

console.log(`\nFotos: el Excel nombra ${totalDeFotos} archivos en ${filas.length - sinFotoEnElExcel} filas.`);
console.log(`  Son vínculos al disco de quien armó la planilla (…\\Microsoft\\Excel\\Fotos\\) y esa carpeta no está.`);
console.log(`  Ninguna se migra. Si aparece, los nombres están en el Excel (columnas W en adelante).`);

console.log(`\nFechas que no cierran (se importan tal cual):`);
if (avisosDeFila.size === 0) console.log("  ninguna");
for (const [n, a] of avisosDeFila) console.log(`  N° ${n}: ${a.join("; ")}`);

if (!escribir) {
  console.log(`\nNo se escribió nada. Con --escribir inserta las ${filas.length}, adelanta la secuencia y guarda la foto de avisos.`);
  process.exit(0);
}

// ── Escribir ────────────────────────────────────────────────

// Lo que ya está: por clave (una corrida anterior) y por número (alguien cargó
// una condición desde el teléfono antes de que corriera esto). Lo segundo no se
// resuelve solo: se corta.
const maximo = Math.max(...numeros);
const yaEstan = await traerTodo((desde, hasta) =>
  db.from(TABLA).select("numero, clave").lte("numero", maximo).range(desde, hasta)
);
const choques = yaEstan.filter((e) => !String(e.clave ?? "").startsWith(PREFIJO_DE_CLAVE));
if (choques.length) {
  console.error(
    `\nNO SE ESCRIBE NADA. Ya hay condiciones con N° entre 1 y ${maximo} que no son de esta importación: ` +
      choques.map((c) => `#${c.numero}`).join(", ")
  );
  process.exit(1);
}
const clavesQueEstan = new Set(yaEstan.map((e) => e.clave as string));
const aInsertar = filas.filter((f) => !clavesQueEstan.has(f.clave));
console.log(`\nYa estaban de una corrida anterior: ${filas.length - aInsertar.length}. A insertar: ${aInsertar.length}.`);

if (aInsertar.length > 0) {
  // Un solo pedido: o entran todas o no entra ninguna.
  const { error } = await db.from(TABLA).insert(aInsertar);
  if (error) {
    console.error(`\nNo se insertó nada. Postgres dijo (sin traducir): ${error.message}`);
    process.exit(1);
  }
  console.log(`Insertadas: ${aInsertar.length}.`);
}

// Se vuelve a leer lo que quedó, y el informe de abajo sale de la base y no de lo que se mandó.
const quedaron = await traerTodo((desde, hasta) =>
  db
    .from(TABLA)
    .select("numero, clave, sector_id, responsable_id, peligro_id, nivel_riesgo, frecuencia")
    .like("clave", `${PREFIJO_DE_CLAVE}%`)
    .range(desde, hasta)
);
console.log(`\nEn la base, con clave de esta importación: ${quedaron.length}`);
console.log(`  sin sector:      ${quedaron.filter((q) => q.sector_id === null).length}`);
console.log(`  sin responsable: ${quedaron.filter((q) => q.responsable_id === null).length}`);
console.log(`  sin peligro:     ${quedaron.filter((q) => q.peligro_id === null).length}`);

// Las tres columnas generadas se contrastan con el nivel que calculó la planilla.
const distintos = quedaron.filter((q) => {
  const esperado = nivelDeLaPlanilla.get(q.numero as number);
  return esperado !== undefined && esperado !== q.nivel_riesgo;
});
const evaluadas = quedaron.filter((q) => q.frecuencia !== null);
console.log(`  evaluadas: ${evaluadas.length}; nivel de la base igual al de la planilla en ${evaluadas.length - distintos.length}`);
for (const q of distintos) console.log(`    N° ${q.numero}: planilla ${nivelDeLaPlanilla.get(q.numero as number)}, base ${q.nivel_riesgo}`);
const sinNivel = quedaron.filter((q) => q.frecuencia === null && q.nivel_riesgo !== null);
if (sinNivel.length) console.log(`  ¡${sinNivel.length} sin evaluar tienen nivel! Revisar.`);

const idsDeLaImportacion = (
  await traerTodo((desde, hasta) =>
    db.from(TABLA).select("id").like("clave", `${PREFIJO_DE_CLAVE}%`).range(desde, hasta)
  )
).map((c) => c.id as string);
// 44 ids caben en una URL; con más de 200 habría que ir de a lotes.
const { count: fotosEnLaBase, error: errorDeFotos } = await db
  .from("syh_fotos")
  .select("id", { count: "exact", head: true })
  .in("condicion_id", idsDeLaImportacion.slice(0, 200));
console.log(`  fotos cargadas en la base para estas: ${errorDeFotos ? `no se pudo contar (${errorDeFotos.message})` : fotosEnLaBase}`);

// ── 1. La secuencia ─────────────────────────────────────────
// Se consumen números hasta que una condición de prueba entra, y se borra. Los
// que chocan con un N° de la planilla fallan con 23505 —y consumen igual el
// número, porque `nextval` no se deshace—. El que entra es mayor al máximo, y a
// partir de ahí el teléfono pide uno libre. Queda un hueco en el N° que usó la
// prueba, y es el costo de no poder correr `setval` desde acá.
const CLAVE_DE_LA_SONDA = "sonda-de-la-secuencia";
await db.from(TABLA).delete().eq("clave", CLAVE_DE_LA_SONDA); // una sonda que quedó de una corrida cortada
let sondeos = 0;
let numeroDeLaSonda: number | null = null;
for (; sondeos < 300; sondeos++) {
  const { data, error } = await db
    .from(TABLA)
    .insert({ descripcion: "sonda de la secuencia (se borra sola)", clave: CLAVE_DE_LA_SONDA })
    .select("id, numero")
    .single();
  if (!error && data) {
    numeroDeLaSonda = data.numero as number;
    await db.from(TABLA).delete().eq("id", data.id);
    break;
  }
  if (error?.code !== "23505") {
    console.error(`\nLa prueba de la secuencia falló por otra cosa (sin traducir): ${error?.message}`);
    process.exit(1);
  }
}
if (numeroDeLaSonda === null) {
  console.error("\nNO SE PUDO ADELANTAR LA SECUENCIA en 300 intentos. Correr en el editor SQL:");
  console.error(`  select setval(pg_get_serial_sequence('public.syh_condiciones', 'numero'), ${maximo}, true);`);
  process.exit(1);
}
const sigueLaSonda = await db.from(TABLA).select("id").eq("clave", CLAVE_DE_LA_SONDA);
console.log(
  `\nSecuencia adelantada: la prueba entró con el N° ${numeroDeLaSonda} tras ${sondeos} choques y se borró` +
    ` (${sigueLaSonda.data?.length ? "¡QUEDÓ UNA FILA DE PRUEBA!" : "no quedó ninguna fila de prueba"}).` +
    ` La próxima condición cargada será la N° ${numeroDeLaSonda + 1} o mayor.`
);

// ── 2. La foto de avisos del día, lo último ─────────────────
const todos = await avisosDeTodoElSistema(db);
const { error: errorDeLaFoto } = await guardarFoto(db, hoy, todos);
if (errorDeLaFoto) {
  console.error(`\nNO SE GUARDÓ LA FOTO DE AVISOS (${errorDeLaFoto}). El primer resumen diario va a anunciar las condiciones como novedad.`);
  process.exit(1);
}
console.log(`\nFoto de avisos de ${hoy} guardada: ${todos.length} avisos. Los de Seguridad e Higiene:`);
for (const a of todos.filter((x) => x.id.startsWith("syh-"))) console.log(`  ${a.id}: ${a.cantidad} — ${a.titulo}`);
if (!todos.some((x) => x.id.startsWith("syh-"))) console.log("  (ninguno)");

console.log("\nListo.");
